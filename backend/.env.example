# Ambiente da Aplicação (development, production)
ENV=development

# Chave secreta de autenticação do ESP32 (Header X-API-Key)
API_KEY=secreto_pim2_unip_2026

# Conexão com o Banco de Dados PostgreSQL (Local ou Nuvem: Supabase / Neon / AWS RDS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecopulse_db

# Coordenadas Geodésicas de Referência da Estação (Campus UNIP / Polo Urbano)
STATION_ID=esp32-meteo-01
STATION_NAME=Estação Meteorológica UNIP - Campus Central
STATION_CITY=São Paulo
STATION_LAT=-23.550520
STATION_LON=-46.633308
STATION_ALTITUDE=760.0
COVERAGE_RADIUS_KM=5.0
